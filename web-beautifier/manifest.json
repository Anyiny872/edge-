{
  "manifest_version": 3,
  "name": "网页美化师 · WebBeautifier",
  "version": "1.0.0",
  "description": "全局网页美化引擎：暗色模式、字体排版优化、圆角卡片、阅读焦点、对比度调节。一次配置全网生效。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "网页美化师 · WebBeautifier"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ]
}